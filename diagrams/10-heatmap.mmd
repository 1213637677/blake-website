    style F fill:#16161a,stroke:#2a2a30,color:#8b8b94
    style RAW fill:#263238,stroke:#4c8dff,color:#ededf0
    style GROUP fill:#263238,stroke:#4c8dff,color:#ededf0
    style TRUNC fill:#263238,stroke:#4c8dff,color:#ededf0
    style SHARD fill:#263238,stroke:#4c8dff,color:#ededf0
    style ENC fill:#263238,stroke:#4c8dff,color:#ededf0
    style F1 fill:#263238,stroke:#4c8dff,color:#ededf0
    style F2 fill:#263238,stroke:#4c8dff,color:#ededf0
    style F3 fill:#263238,stroke:#4c8dff,color:#ededf0
