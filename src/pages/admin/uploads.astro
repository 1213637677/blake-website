---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { verifySession } from '../../lib/auth';
import { ADMIN_COOKIE } from '../../config';
import { MAX_UPLOAD } from '../../lib/store';
import fs from 'node:fs/promises';
import path from 'node:path';

export const prerender = false;

if (!verifySession(Astro.cookies.get(ADMIN_COOKIE)?.value)) {
  return Astro.redirect('/admin/login');
}

const dir = path.resolve(process.cwd(), 'public/uploads');
let files: { name: string; size: number; mtime: number }[] = [];
try {
  const list = await fs.readdir(dir);
  files = await Promise.all(
    list
      .filter((f) => /\.(png|jpe?g|webp|gif|svg)$/i.test(f))
      .map(async (f) => {
        const st = await fs.stat(path.join(dir, f));
        return { name: f, size: st.size, mtime: st.mtimeMs };
      }),
  );
  files.sort((a, b) => b.mtime - a.mtime);
} catch {
  files = [];
}

const error = Astro.url.searchParams.get('error');
const uploaded = Astro.url.searchParams.get('uploaded');

const kb = (n: number) => `${Math.round(n / 1024)} KB`;
---

<AdminLayout>
  <header class="head">
    <p class="eyebrow">Uploads</p>
    <h1 class="title">图片</h1>
  </header>

  <p class="hint">
    上传到的图片会落到 <code>public/uploads/</code>，正文里用 <code>![说明](/uploads/文件名)</code> 引用。单张不超过 {Math.round(MAX_UPLOAD / 1024 / 1024)} MB。
  </p>

  {error && <p class="alert" role="alert">{error}</p>}
  {uploaded && <p class="ok">已上传：<code>/uploads/{uploaded}</code></p>}

  <form class="drop" method="post" action="/admin/upload" enctype="multipart/form-data">
    <input class="file" type="file" name="file" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" required />
    <button class="btn btn--primary" type="submit">
      <Icon name="image" size={16} />
      上传
    </button>
  </form>

  {
    files.length === 0 ? (
      <div class="empty">
        <p class="empty__title">还没有图片</p>
        <p>上传第一张试试。</p>
      </div>
    ) : (
      <ul class="grid">
        {files.map((f) => (
          <li class="cell">
            <a class="cell__link" href={`/uploads/${f.name}`} target="_blank" rel="noopener noreferrer">
              <img class="cell__img" src={`/uploads/${f.name}`} alt={f.name} loading="lazy" />
              <span class="cell__name">{f.name}</span>
              <span class="cell__meta meta">{kb(f.size)}</span>
            </a>
            <code class="cell__code">/uploads/{f.name}</code>
          </li>
        ))}
      </ul>
    )
  }
</AdminLayout>

<style>
  .head {
    margin-bottom: var(--space-3);
  }

  .title {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-top: var(--space-3);
  }

  .hint {
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.7;
    margin-bottom: var(--space-5);
    overflow-wrap: anywhere;
  }

  .alert {
    border: 1px solid var(--signal);
    background: var(--signal-soft);
    color: var(--signal);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
    font-size: 0.9375rem;
  }

  .ok {
    border: 1px solid var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
    font-size: 0.9375rem;
  }

  .drop {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius);
    background: var(--paper-2);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .file {
    flex: 1 1 240px;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-4);
    list-style: none;
  }

  .cell {
    border: 1.5px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-2);
    overflow: hidden;
    min-width: 0;
  }

  .cell__link {
    display: block;
    color: var(--ink);
  }

  .cell__link:hover {
    text-decoration: none;
  }

  .cell__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--paper-3);
    border-bottom: 1px solid var(--rule);
  }

  .cell__name {
    display: block;
    padding: var(--space-3) var(--space-3) 0;
    font-size: 0.8125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cell__meta {
    display: block;
    padding: 2px var(--space-3) var(--space-3);
    font-size: 0.6875rem;
  }

  .cell__code {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid var(--rule);
    font-size: 0.6875rem;
    color: var(--ink-3);
    background: var(--paper);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  code {
    font-family: var(--font-sans);
    font-size: 0.85em;
    background: var(--paper-3);
    padding: 1px 5px;
    border-radius: 3px;
  }
</style>
