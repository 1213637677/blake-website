---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterBar from '../../components/FilterBar.astro';
import Cover from '../../components/Cover.astro';
import Icon from '../../components/Icon.astro';
import { getProjects } from '../../lib/entries';
import { readingTime } from '../../lib/entries';
import { fmtDate } from '../../lib/format';
import { url } from '../../lib/url';

const projects = await getProjects();
const tags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();

const SEGMENTS = [
  { value: 'all', label: '全部' },
  { value: 'work', label: '工作项目' },
  { value: 'personal', label: '个人项目' },
];

// 大卡片 / 小卡片交替，打破均匀网格
const cells = projects.map((p, i) => ({
  p,
  big: i % 3 === 0,
  minutes: readingTime(p.body ?? ''),
}));
---

<BaseLayout title="项目" description="做过的工作项目与自己发起的项目。">
  <div class="container page">
    <header class="head">
      <p class="eyebrow">Projects</p>
      <h1 class="head__title">做过的事</h1>
      <p class="head__desc">
        工作里负责的，和业余自己做着玩的。<span class="mark">含背景、我的角色、技术栈与结果。</span>
      </p>
    </header>

    <FilterBar tags={tags} itemSelector="[data-item]" segments={SEGMENTS} />

    {
      projects.length === 0 ? (
        <div class="empty">
          <p class="empty__title">还没有项目</p>
          <p>在 <code>content/projects/</code> 新建 Markdown，或到 <a href={url("/admin")}>后台</a> 添加。</p>
        </div>
      ) : (
    <h2 class="visually-hidden">全部项目</h2>
        <ul class="grid">
          {cells.map(({ p, big, minutes }) => (
            <li
              class:list={['cell', 'reveal', { 'cell--wide': big }]}
              data-item
              data-search={`${p.data.title} ${p.data.summary} ${p.data.tags.join(' ')} ${p.data.stack.join(' ')}`}
              data-tags={p.data.tags.join('|')}
              data-seg={p.data.kind}
            >
              <a class="cell__link" href={url(`/projects/${p.id}`)}>
                <Cover
                  seed={p.id}
                  label={p.data.title}
                  src={p.data.cover}
                  ratio={big ? 'wide' : 'square'}
                />

                <div class="cell__body">
                  <div class="cell__top">
                    <span class:list={['badge', `badge--${p.data.kind}`]}>
                      {p.data.kind === 'work' ? '工作' : '个人'}
                    </span>
                    <span class="status">{minutes} min</span>
                  </div>

                  <h3 class="cell__title">{p.data.title}</h3>
                  {p.data.summary && <p class="cell__summary">{p.data.summary}</p>}

                  <div class="cell__foot">
                    <span class="meta">{p.data.period || fmtDate(p.data.date)}</span>
                    {p.data.stack.length > 0 && (
                      <ul class="tag-list cell__stack">
                        {p.data.stack.slice(0, 4).map((s) => (
                          <li><span class="tag">{s}</span></li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>

                <span class="cell__go" aria-hidden="true">
                  <Icon name="arrowUpRight" size={18} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="empty" data-filter-empty hidden>
      <p class="empty__title">没有匹配的项目</p>
      <p>换个关键词，或切换到另一个分类。</p>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-8) var(--space-9);
  }

  .head {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    max-width: 60ch;
  }

  .head__desc {
    color: var(--fg-2);
    font-size: 1.0625rem;
    line-height: 1.85;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    list-style: none;
  }

  .cell {
    min-width: 0;
  }

  /* 每第 1 张横跨两列，打破均匀 */
  .cell--wide {
    grid-column: span 2;
  }

  .cell__link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1.5px solid var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
    overflow: hidden;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease;
  }

  .cell__link:hover {
    transform: translateY(-2px);
  }

  .cell__link :global(.cover) {
    border: 0;
    border-bottom: 1.5px solid var(--fg);
    border-radius: 0;
  }

  .cell__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    flex: 1;
  }

  .cell__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .badge {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 3px 9px;
    border: 1.5px solid currentColor;
    border-radius: var(--radius);
  }

  .badge--work {
    color: var(--acc);
  }

  .badge--personal {
    color: var(--fg-2);
  }

  .status {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .cell__title {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .cell--wide .cell__title {
    font-size: 1.0625rem;
  }

  .cell__summary {
    color: var(--fg-2);
    font-size: 0.9375rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .cell__foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .cell__stack .tag {
    font-size: 0.625rem;
  }

  .cell__go {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    border: 1.5px solid var(--fg);
    border-radius: var(--radius);
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .cell__link:hover .cell__go {
    opacity: 1;
    transform: scale(1);
  }

  code {
    font-family: var(--font-sans);
    font-size: 0.85em;
    background: var(--surface-2);
    padding: 1px 5px;
    border-radius: 3px;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cell--wide {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .cell--wide {
      grid-column: span 1;
    }

    .cell__go {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
