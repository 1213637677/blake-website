---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterBar from '../../components/FilterBar.astro';
import Cover from '../../components/Cover.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, readingTime } from '../../lib/entries';
import { fmtDate, tagHref } from '../../lib/format';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

const KIND_LABEL: Record<string, string> = {
  essay: '随笔',
  learning: '学习',
  retro: '复盘',
};

const items = posts.map((p) => ({ post: p, minutes: readingTime(p.body ?? '') }));
---

<BaseLayout title="文章" description="写下来的想法、学习过程与复盘。">
  <div class="container page">
    <header class="head">
      <p class="eyebrow">Writing</p>
      <h1 class="head__title">写下来</h1>
      <p class="head__desc">
        感悟、学习记录与阶段复盘。<span class="mark">长一点的放这里，一句话的放笔记。</span>
      </p>
    </header>

    <FilterBar tags={tags} itemSelector="[data-item]" />

    {
      items.length === 0 ? (
        <div class="empty">
          <p class="empty__title">还没有文章</p>
          <p>在 <code>content/posts/</code> 新建 Markdown，或到 <a href="/admin">后台</a> 写一篇。</p>
        </div>
      ) : (
        <h2 class="visually-hidden">全部文章</h2>
    <div class="grid">
          {items.map(({ post, minutes }) => (
            <article
              class="card reveal"
              data-item
              data-search={`${post.data.title} ${post.data.summary} ${post.data.tags.join(' ')}`}
              data-tags={post.data.tags.join('|')}
            >
              <a class="card__link" href={`/writing/${post.id}`}>
                <Cover seed={post.id} label={post.data.title} src={post.data.cover} ratio="wide" />

                <div class="card__body">
                  <p class="card__meta">
                    <span>{KIND_LABEL[post.data.kind] ?? '随笔'}</span>
                    <span class="sep">·</span>
                    <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
                    <span class="sep">·</span>
                    <span>{minutes} min</span>
                    {post.data.draft && <span class="draft">草稿</span>}
                  </p>

                  <h3 class="card__title">{post.data.title}</h3>
                  {post.data.summary && <p class="card__summary">{post.data.summary}</p>}

                  {post.data.tags.length > 0 && (
                    <ul class="tag-list card__tags">
                      {post.data.tags.slice(0, 3).map((t) => (
                        <li><span class="tag">#{t}</span></li>
                      ))}
                    </ul>
                  )}
                </div>
              </a>
            </article>
          ))}
        </div>
      )
    }

    <div class="empty" data-filter-empty hidden>
      <p class="empty__title">没有匹配的文章</p>
      <p>换个关键词，或清空筛选。</p>
    </div>

    {
      tags.length > 0 && (
        <nav class="all-tags" aria-label="全部标签">
          <p class="eyebrow">Tags</p>
          <ul class="tag-list">
            {tags.map((t) => (
              <li><a class="tag" href={tagHref(t)}>#{t}</a></li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-8) var(--space-9);
  }

  .head {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    max-width: 60ch;
  }

  .head__desc {
    color: var(--fg-2);
    font-size: 1.0625rem;
    line-height: 1.85;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .card {
    min-width: 0;
  }

  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1.5px solid var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
    overflow: hidden;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease;
  }

  .card__link:hover {
    transform: translateY(-2px);
  }

  .card__link :global(.cover) {
    border: 0;
    border-bottom: 1.5px solid var(--fg);
    border-radius: 0;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    flex: 1;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .sep {
    opacity: 0.5;
  }

  .draft {
    background: var(--g-note);
    color: #1a1a18;
    padding: 1px 5px;
  }

  .card__title {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .card__summary {
    color: var(--fg-2);
    font-size: 0.9375rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .card__tags {
    margin-top: auto;
    padding-top: var(--space-3);
  }

  .card__tags .tag {
    font-size: 0.625rem;
  }

  .all-tags {
    margin-top: var(--space-9);
    padding-top: var(--space-5);
    border-top: 2px solid var(--fg);
  }

  .all-tags .tag-list {
    margin-top: var(--space-4);
  }

  code {
    font-family: var(--font-sans);
    font-size: 0.85em;
    background: var(--surface-2);
    padding: 1px 5px;
    border-radius: 3px;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
