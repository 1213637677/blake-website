---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';

const contacts = [
  site.email && { label: '邮箱', value: site.email, href: `mailto:${site.email}`, icon: 'mail' },
  site.repo && { label: 'GitHub', value: site.repo, href: site.repo, icon: 'github' },
].filter(Boolean) as { label: string; value: string; href: string; icon: string }[];

const facts = [
  { k: '内容源', v: 'Git 仓库里的 Markdown' },
  { k: '构建', v: 'Astro · 静态预渲染' },
  { k: '搜索', v: '构建期索引，纯前端' },
  { k: '后台', v: '写回同一批 Markdown 文件' },
];
---

<BaseLayout title="关于" description={site.intro}>
  <div class="container page">
    <header class="head">
      <p class="eyebrow">About</p>
      <h1 class="head__title">关于</h1>
    </header>

    <div class="grid">
      <div class="col">
        <section class="block">
          <h2 class="block__title">简介</h2>
          <p class="block__text">{site.intro}</p>
          <p class="block__hint">
            这段内容在 <code>src/config.ts</code> 里维护，随时可以改写。
          </p>
        </section>

        <section class="block">
          <h2 class="block__title">这个站怎么搭的</h2>
          <dl class="facts">
            {
              facts.map((f) => (
                <div class="facts__row">
                  <dt>{f.k}</dt>
                  <dd>{f.v}</dd>
                </div>
              ))
            }
          </dl>
        </section>
      </div>

      <aside class="col side">
        <section class="block">
          <h2 class="block__title">联系</h2>
          {
            contacts.length === 0 ? (
              <p class="block__hint">联系方式待补充，可在 <code>src/config.ts</code> 填写。</p>
            ) : (
              <ul class="contacts">
                {contacts.map((c) => (
                  <li>
                    <a class="btn" href={c.href} rel="noopener noreferrer" target="_blank">
                      <Icon name={c.icon} size={15} />
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </section>

        {
          site.socials.length > 0 && (
            <section class="block">
              <h2 class="block__title">在别处</h2>
              <ul class="socials">
                {site.socials.map((s) => (
                  <li>
                    <a href={s.href} rel="me noopener noreferrer" target="_blank">
                      {s.label}
                      <Icon name="arrowUpRight" size={14} />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          site.resume && (
            <section class="block">
              <h2 class="block__title">简历</h2>
              <a class="btn" href={site.resume} target="_blank" rel="noopener noreferrer">
                <Icon name="link" size={15} />
                查看简历
              </a>
            </section>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-8) var(--space-9);
  }

  .head {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .block + .block {
    margin-top: var(--space-8);
  }

  .block__title {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--fg);
    margin-bottom: var(--space-4);
  }

  .block__text {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--fg-2);
    max-width: 56ch;
  }

  .block__hint {
    margin-top: var(--space-4);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--fg-3);
    overflow-wrap: anywhere;
  }

  .facts {
    margin: 0;
  }

  .facts__row {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px dashed var(--line);
    font-size: 0.9375rem;
  }

  .facts__row dt {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .facts__row dd {
    margin: 0;
  }

  /* 侧栏：贴纸块 */
  .side .block {
    padding: var(--space-5);
    background: var(--surface);
    border: 1.5px solid var(--fg);
    border-radius: var(--radius);
  }

  .side .block + .block {
    margin-top: var(--space-5);
  }

  .contacts {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
  }

  .contacts .btn {
    width: 100%;
    justify-content: flex-start;
  }

  .socials {
    list-style: none;
  }

  .socials li + li {
    margin-top: var(--space-2);
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
    border-bottom: 1.5px solid var(--line-2);
    padding-bottom: 1px;
  }

  .socials a:hover {
    color: var(--acc);
    border-color: var(--acc);
  }

  code {
    font-family: var(--font-sans);
    font-size: 0.85em;
    background: var(--surface-2);
    padding: 1px 5px;
    border-radius: 3px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7);
    }
  }
</style>
