---
/**
 * 给正文里的代码块加语言标签与复制按钮。
 */
const COPY_ICON =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16V6a2 2 0 0 1 2-2h10"/></svg>';
const OK_ICON =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
---

<script define:vars={{ COPY_ICON, OK_ICON }}>
  (() => {
    const blocks = document.querySelectorAll('.prose pre');
    blocks.forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-block')) return;

      const wrap = document.createElement('div');
      wrap.className = 'code-block';
      pre.replaceWith(wrap);
      wrap.appendChild(pre);

      const code = pre.querySelector('code');
      // Shiki 输出的是 data-language 属性，class 里只有 astro-code + 主题名
      const cls = (code?.className ?? '') + ' ' + (pre.className ?? '');
      const fromAttr = pre.getAttribute('data-language') ?? '';
      const lang = fromAttr || (cls.match(/(?:language|lang)-([a-z0-9+#-]+)/i) ?? [])[1] || '';

      if (lang) {
        const label = document.createElement('span');
        label.className = 'code-block__lang';
        label.textContent = lang;
        wrap.appendChild(label);
      }

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-block__copy';
      btn.setAttribute('aria-label', '复制代码');
      btn.innerHTML = COPY_ICON;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code?.textContent ?? '');
          btn.innerHTML = OK_ICON;
          setTimeout(() => (btn.innerHTML = COPY_ICON), 1400);
        } catch {
          btn.setAttribute('aria-label', '复制失败');
        }
      });
      wrap.appendChild(btn);
    });
  })();
</script>
