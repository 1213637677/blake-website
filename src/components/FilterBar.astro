---
import Icon from './Icon.astro';

interface Props {
  tags: string[];
  placeholder?: string;
  segments?: { value: string; label: string }[];
  itemSelector: string;
}

const { tags, placeholder = '搜索标题、摘要或标签', segments = [], itemSelector } = Astro.props;
---

<div class="filters" data-filter-bar data-item-selector={itemSelector}>
  <div class="filters__row">
    <div class="search">
      <Icon name="search" size={16} class="search__icon" />
      <input
        class="search__input"
        type="search"
        placeholder={placeholder}
        aria-label={placeholder}
        data-filter-query
      />
    </div>

    {
      segments.length > 0 && (
        <div class="filters__seg" role="tablist" aria-label="分类切换">
          {segments.map((s, i) => (
            <button
              role="tab"
              class:list={['seg', { 'is-active': i === 0 }]}
              data-seg={s.value}
              aria-selected={String(i === 0)}
            >
              {s.label}
            </button>
          ))}
        </div>
      )
    }
  </div>

  {
    tags.length > 0 && (
      <div class="filters__tags">
        <button class="tag is-active" data-tag="" aria-pressed="true">全部</button>
        {tags.map((t) => (
          <button class="tag" data-tag={t} aria-pressed="false">#{t}</button>
        ))}
      </div>
    )
  }

  <p class="filters__count meta" data-filter-count hidden></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-filter-bar]').forEach((bar) => {
    const selector = bar.dataset.itemSelector ?? '[data-item]';
    const items = Array.from(document.querySelectorAll<HTMLElement>(selector));
    const queryInput = bar.querySelector<HTMLInputElement>('[data-filter-query]');
    const tagButtons = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-tag]'));
    // 注意：项目卡片也带 data-seg，这里必须限定在 bar 内，否则会误选卡片
    const segButtons = Array.from(bar.querySelectorAll<HTMLButtonElement>('.filters__seg [data-seg]'));
    const count = bar.querySelector<HTMLElement>('[data-filter-count]');
    const emptyState = document.querySelector<HTMLElement>('[data-filter-empty]');

    let activeTag = '';
    let activeSeg = segButtons[0]?.dataset.seg ?? '';

    const norm = (s: string) => s.toLowerCase();

    const apply = () => {
      const q = norm(queryInput?.value.trim() ?? '');
      let visible = 0;

      items.forEach((el) => {
        const hay = norm(el.dataset.search ?? el.textContent ?? '');
        const tags = (el.dataset.tags ?? '').split('|').filter(Boolean);
        const seg = el.dataset.seg ?? '';
        // activeSeg 为 'all'（或空）时不按类型过滤
        const segOk = !activeSeg || activeSeg === 'all' || seg === activeSeg;
        const ok = (!q || hay.includes(q)) && (!activeTag || tags.includes(activeTag)) && segOk;
        el.hidden = !ok;
        if (ok) visible += 1;
      });

      if (count) {
        count.hidden = items.length === visible;
        count.textContent = `${visible} / ${items.length} 条`;
      }
      if (emptyState) emptyState.hidden = visible !== 0;
    };

    const setPressed = (btns: HTMLButtonElement[], on: HTMLButtonElement) => {
      btns.forEach((b) => {
        const active = b === on;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
    };

    tagButtons.forEach((b) =>
      b.addEventListener('click', () => {
        activeTag = b.dataset.tag ?? '';
        setPressed(tagButtons, b);
      }),
    );

    segButtons.forEach((b) =>
      b.addEventListener('click', () => {
        activeSeg = b.dataset.seg ?? '';
        segButtons.forEach((s) => {
          const active = s === b;
          s.classList.toggle('is-active', active);
          s.setAttribute('aria-selected', String(active));
        });
      }),
    );

    // 分组容器：筛选后组内无可选项则整体隐藏
    const groupSel = bar.dataset.groupSelector ?? '[data-group]';
    const groups = Array.from(document.querySelectorAll<HTMLElement>(groupSel));
    const syncGroups = () => {
      groups.forEach((g) => {
        g.hidden = g.querySelectorAll<HTMLElement>('[data-item]:not([hidden])').length === 0;
      });
    };

    // 首屏立即应用一次，避免视觉选中态与实际筛选不一致
    const run = () => {
      apply();
      syncGroups();
    };
    run();
    queryInput?.addEventListener('input', run);
    tagButtons.forEach((b) => b.addEventListener('click', run));
    segButtons.forEach((b) => b.addEventListener('click', run));
  });
</script>

<style>
  .filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-6);
    border-bottom: 1.5px solid var(--fg);
  }

  .filters__row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
  }

  .search {
    position: relative;
    flex: 1 1 260px;
    max-width: 400px;
  }

  .search__icon {
    position: absolute;
    left: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    color: var(--fg-3);
    pointer-events: none;
  }

  .search__input {
    width: 100%;
    min-height: 44px;
    padding: 0 var(--space-3) 0 38px;
    border: 1.5px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    font-size: 0.9375rem;
    transition: border-color 0.15s ease;
  }

  .search__input:focus {
    border-color: var(--fg);
    outline: 2px solid var(--acc);
    outline-offset: 1px;
  }

  .filters__seg {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 1.5px solid var(--fg);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .seg {
    min-height: 36px;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: var(--fg-2);
    font-size: 0.875rem;
    font-weight: 550;
    cursor: pointer;
    white-space: nowrap;
  }

  .seg.is-active {
    background: var(--fg);
    color: var(--bg);
  }

  .filters__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filters__tags .tag {
    cursor: pointer;
  }

  .filters__tags .tag.is-active {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

  .filters__count {
    text-transform: none;
    letter-spacing: 0.06em;
  }
</style>
